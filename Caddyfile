# Naming a real domain turns on automatic HTTPS: Caddy fetches and renews
# Let's Encrypt certs (stored in the caddy_data volume) and redirects
# http:// to https://. Requires DNS pointing here and ports 80 + 443 open.
#
# SITE_DOMAIN defaults to production. For local testing, run the container
# with SITE_DOMAIN=localhost and Caddy uses a self-signed cert instead.

{$SITE_DOMAIN:jeremyhamning.com} {
	root * /srv
	encode zstd gzip

	# Vite fingerprints everything in /assets, so it can be cached forever
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# Everything else (index.html via "/" or SPA fallback) must be revalidated
	# so new deploys show up immediately
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	# SPA fallback: unknown paths serve index.html
	try_files {path} /index.html
	file_server
}

# The bare domain is canonical; send www there, keeping the path
www.{$SITE_DOMAIN:jeremyhamning.com} {
	redir https://{$SITE_DOMAIN:jeremyhamning.com}{uri} permanent
}
